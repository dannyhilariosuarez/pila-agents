{
  "name": "@pila/protocol",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Pila agent protocol interfaces and base classes",
  "keywords": [
    "pila",
    "agents",
    "agent-protocol",
    "ai",
    "a2a",
    "mcp",
    "registry"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannyhilariosuarez/pila-agents.git",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsc --build --force"
  },
  "dependencies": {
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "homepage": "https://github.com/dannyhilariosuarez/pila-agents/tree/main/packages/protocol",
  "bugs": {
    "url": "https://github.com/dannyhilariosuarez/pila-agents/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
