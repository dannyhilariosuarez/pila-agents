{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "paths": {
      "@pila/registry": ["./packages/registry/src"],
      "@pila/protocol": ["./packages/protocol/src"],
      "@pila/shared": ["./packages/shared/src"]
    }
  },
  "exclude": ["node_modules", "dist", "apps/web", "sdks", "scripts"]
}
